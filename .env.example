# ============================================================
# Autometric — Environment Variables
# Copy file ini ke .env dan isi semua value.
# .env sudah di-ignore oleh .dockerignore (tidak masuk image).
# ============================================================

# --------------------------------------------------------
# PostgreSQL
# --------------------------------------------------------
POSTGRES_USER=autometric
POSTGRES_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT
POSTGRES_DB=autometric_v2
POSTGRES_PORT=5432

# --------------------------------------------------------
# Redis
# --------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# --------------------------------------------------------
# Dagster Database URL (format: postgresql://user:pass@host:port/db)
# Saat pakai docker-compose, host = nama service "postgres"
# Untuk koneksi dari luar container (lokal dev), ganti host -> localhost
# --------------------------------------------------------
AUTOMETRIC_DB_URL=postgresql://autometric:GANTI_DENGAN_PASSWORD_KUAT@postgres:5432/autometric_v2

# --------------------------------------------------------
# Dagster UI Port
# --------------------------------------------------------
DAGSTER_PORT=3000

# --------------------------------------------------------
# (Opsional) HuggingFace Hub Token
# Hanya perlu kalau model NLP private / rate limit tinggi
# --------------------------------------------------------
# HUGGINGFACE_HUB_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx
